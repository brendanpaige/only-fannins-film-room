# Most of this folder is private draft work (database, rankings, exports).
# Only the Film Room dashboard is published, so ignore everything and opt
# files in one at a time. league_data.js is rebuilt and committed by the
# GitHub Action each week.
/*
!/.gitignore
!/.github/
!/league_insights.py
!/lib/
/lib/*
!/lib/__init__.py
!/lib/sleeper.py
!/league/
/league/*
!/league/film_room.html
!/league/league_data.js
!/league/og.png
!/league/og_card.html
