# Most of this folder is private draft work (database, rankings, exports).
# Only the Film Room dashboard is published, so ignore everything and opt
# files in one at a time. league_data.js is built by the GitHub Action.
/*
!/.gitignore
!/.github/
!/league_insights.py
!/lib/
/lib/*
!/lib/__init__.py
!/lib/sleeper.py
!/league/
/league/*
!/league/film_room.html
